@extends('layouts.app')

@section('content')
<div class="container docs-shell">
    @include('partials.docs-side')
    <article class="docs-body">
        <h1>Craft CLI</h1>
        <p>Craft is Kotlimo's command runner. Inside an application, invoke it through that app's Gradle run task. From this repository you can also scaffold apps with the console module.</p>

        <h2>Create an app</h2>
        <pre><code>./gradlew :kotlimo-console:run --args='new blog'
./kotlimo new blog</code></pre>

        <h2>Application commands</h2>
        <pre><code>./gradlew run --args='list'
./gradlew run --args='serve --port=8000'
./gradlew run --args='route:list'
./gradlew run --args='migrate'
./gradlew run --args='migrate:rollback'
./gradlew run --args='make:migration create_posts_table'
./gradlew run --args='make:controller UserController'
./gradlew run --args='make:model Post'
./gradlew run --args='key:generate'
./gradlew run --args='schedule:run'
./gradlew run --args='queue:work --once'</code></pre>
        <p>This documentation site is itself an app, so the same commands work as <code class="inline">./gradlew :website:run --args='route:list'</code>.</p>

        <h2>What they do</h2>
        <ul>
            <li><code class="inline">list</code> — show registered commands</li>
            <li><code class="inline">serve</code> — start the Kotlin development server</li>
            <li><code class="inline">route:list</code> — print HTTP routes</li>
            <li><code class="inline">migrate</code> / <code class="inline">migrate:rollback</code> — run JSON files in <code class="inline">database/migrations</code></li>
            <li><code class="inline">make:migration</code> / <code class="inline">make:controller</code> / <code class="inline">make:model</code> — generate starters</li>
            <li><code class="inline">key:generate</code> — write <code class="inline">APP_KEY</code> into <code class="inline">.env</code></li>
            <li><code class="inline">schedule:run</code> — run due scheduler callbacks</li>
            <li><code class="inline">queue:work</code> — drain the in-memory array queue</li>
            <li><code class="inline">site:export</code> — write static HTML for GitHub Pages (website module only)</li>
        </ul>

        <h2>Custom commands</h2>
        <pre><code>class PingCommand : Command() {
    override val signature = "ping"
    override val description = "Print pong"
    override fun handle(): Int {
        line("pong")
        return 0
    }
}

app.make(ConsoleKernel::class).register(PingCommand())</code></pre>
    </article>
</div>
@endsection
