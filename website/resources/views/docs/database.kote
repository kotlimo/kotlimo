    <article class="docs-body">
        <h1>Database</h1>
        <p>Kotlimo includes a fluent query builder, Active Record models, schema blueprints, and migrations. The default connection is H2; point <code class="inline">DB_URL</code> at SQLite, MySQL, or PostgreSQL.</p>

        <h2>Query builder</h2>
        <pre><code>DB.table("users")
    .where("email", "ada@example.com")
    .first()

DB.table("posts").insert(mapOf(
    "title" to "Hello",
    "user_id" to 1
))</code></pre>

        <h2>Models</h2>
        <pre><code>class User : Model() {
    override val fillable = listOf("name", "email")
    companion object : ModelCompanion&lt;User&gt;(User::class)
}

val user = User.create(mapOf("name" to "Ada", "email" to "ada@example.com"))
User.find(user.id!!)</code></pre>

        <h2>Schema</h2>
        <pre><code>Schema.create("users") {
    id()
    string("name")
    string("email").unique()
    timestamps()
}</code></pre>
