APP_NAME=Kotlimo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=

# H2 in-memory by default. SQLite, PostgreSQL, and MySQL drivers ship on the classpath.
DB_URL=jdbc:h2:mem:kotlimo;MODE=MySQL;DB_CLOSE_DELAY=-1
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array
QUEUE_DRIVER=sync
MAIL_DRIVER=log
HASH_DRIVER=bcrypt
